{
  "schema_version": "2.0",
  "style_id": "investor-read-ahead",
  "display_name": "Investor Read-Ahead",
  "description": "Evidence-led investment committee pre-read; no promotional styling.",
  "audience": ["investor"],
  "formality": "executive",
  "presentation_context": ["self_reading", "review"],
  "aspect_ratios": ["16:9"],
  "colors": {"primary": "#0B1F3A", "accent": "#C77900", "background": "#F7F9FC", "surface_1": "#EAF0F7", "surface_2": "#DDE7F2", "text_primary": "#14243A", "text_secondary": "#5B667A", "border": "#C9D5E3", "positive": "#236B4B", "warning": "#A86400", "negative": "#A33A3A", "data_series": ["#0B1F3A", "#C77900", "#236B4B"], "allowed_opacity": [0.08, 0.12, 0.18, 1]},
  "typography": {"font_primary": ["Aptos", "Noto Sans CJK SC", "Microsoft YaHei", "sans-serif"], "font_editorial": ["Noto Serif CJK SC", "SimSun", "serif"], "font_mono": ["JetBrains Mono", "Consolas", "monospace"], "title_sizes_pt": {"cover": 34, "section": 28, "slide": 23}, "body_sizes_pt": {"large": 16, "normal": 14, "small": 11, "footnote": 8.5}, "metric_sizes_pt": {"hero": 30, "normal": 22}, "minimum_body_size_pt": 10, "minimum_footnote_size_pt": 8, "line_height": {"cover_title": 1.05, "slide_title": 1.1, "body": 1.3}, "paragraph_spacing_pt": {"body": 6, "list": 4}, "letter_spacing_pt": {"cover_title": 0, "uppercase_label": 0.8}, "weights": {"regular": 400, "semibold": 600, "bold": 700}},
  "grid": {"columns": 12, "rows": 8, "margin_left_in": 0.6, "margin_right_in": 0.6, "margin_top_in": 0.42, "margin_bottom_in": 0.36, "gutter_horizontal_in": 0.16, "gutter_vertical_in": 0.12, "title_zone_height_in": 0.72, "footer_zone_height_in": 0.24, "safe_zone_in": {"left": 0.08, "right": 0.08, "top": 0.06, "bottom": 0.06}},
  "spacing": {"unit": "in", "scale": {"xs": 0.06, "sm": 0.1, "md": 0.16, "lg": 0.24, "xl": 0.36}, "rules": {"title_to_body": "lg", "card_gap": "md", "section_gap": "xl", "paragraph_gap": "sm"}},
  "shape_tokens": {"card_radius_pt": 6, "border_width_pt": 0.8},
  "shadow_tokens": {"default": {"enabled": false}},
  "card_tokens": {"default": {"fill": "surface_1", "text_color": "text_primary", "border_color": "border"}, "highlight": {"fill": "primary", "text_color": "background", "border_color": "primary"}, "metric": {"fill": "background", "number_color": "primary", "label_color": "text_secondary"}, "risk": {"fill": "surface_1", "border_color": "warning"}, "quote": {"fill": "surface_1", "border_color": "accent"}, "comparison": {"fill": "background", "text_color": "text_primary", "border_color": "border"}, "source": {"fill": "surface_2", "text_color": "text_secondary", "border_color": "border"}},
  "table_tokens": {"default": {"header_fill": "primary", "header_text": "background", "body_fill": "background", "text_color": "text_primary"}},
  "chart_tokens": {"series_colors": ["primary", "accent", "positive"], "zero_baseline_required_for_bar": true},
  "diagram_tokens": {"node": {"fill": "surface_1", "text_color": "text_primary"}, "connector": {"default_color": "primary"}},
  "image_tokens": {"default_crop_mode": "cover", "allow_full_bleed": false},
  "icon_tokens": {"stroke_width_pt": 1.4, "default_color": "text_secondary"},
  "footer_tokens": {"enabled": true, "height_in": 0.24, "font_size_ref": "typography.body_sizes_pt.footnote"},
  "density_limits": {"low": {"max_primary_objects": 2}, "medium": {"max_primary_objects": 4}, "high": {"max_primary_objects": 6}},
  "allowed_effects": ["subtle_divider", "single_accent_rule"],
  "forbidden_drift": ["promotional language", "generic consulting template", "whole-slide raster"],
  "compatibility_aliases": []
}
