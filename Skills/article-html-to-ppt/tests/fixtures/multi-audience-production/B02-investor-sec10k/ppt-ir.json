    {"id": "S01", "index": 1, "slide_role": "cover", "title_role": "navigation", "title": "Duolingo 2025 Form 10-K", "judgment": null, "message": "投资委员会商业尽调读前材料｜仅含公开历史披露｜不构成投资建议", "audience_question": "本材料的决策用途和边界是什么？", "source_refs": [{"source_id": "B02-duolingo-2025-10k", "locator": "Form 10-K filed 2026-02-27", "claim_type": "direct"}], "primary_expression": "conceptual_scene", "supporting_expressions": ["source_note"], "primary_anchor": "title", "objects": [], "delivery_contract": {"preferred_route": "native_ppt", "editable_core": ["title"], "raster_allowance": [], "forbidden_raster": ["title"]}},
    {"id": "S02", "index": 2, "slide_role": "judgment", "title_role": "judgment", "title": "披露能验证历史表现，不能替代持续性或估值判断", "judgment": "本材料将“已披露事实”与“后续尽调问题”分层，避免把增长直接写成投资结论。", "message": "公开信息是初筛证据，不是完整商业尽调。", "audience_question": "哪些结论可以从披露直接得到？", "source_refs": [{"source_id": "B02-duolingo-2025-10k", "locator": "Form 10-K and Item 1A", "claim_type": "direct"}, {"source_id": "B02-sec-company-facts", "locator": "FY2023–FY2025 facts", "claim_type": "direct"}], "primary_expression": "table_matrix", "supporting_expressions": ["interpretation", "source_note"], "primary_anchor": "evidence-boundary", "objects": [{"id": "evidence-boundary", "type": "table", "component_type": "native_table", "semantic_role": "evidence_boundary", "content": {"headers": ["信息层", "本材料可确认", "不得据此推导"], "body": [["历史财务", "年度收入、净利润（已申报）", "未来增长率或估值"], ["经营披露", "商业模式与约 9% MAU 为付费订阅者", "客户留存、队列质量或单位经济"], ["风险因素", "竞争、付费需求、隐私/数据、AI 监管方向", "风险已经发生或影响规模"]]}, "source_refs": [{"source_id": "B02-duolingo-2025-10k", "locator": "Business; Item 1A", "claim_type": "direct"}], "editability": "native_required", "priority": "primary"}], "delivery_contract": {"preferred_route": "native_table", "editable_core": ["title", "evidence-boundary"], "raster_allowance": [], "forbidden_raster": ["title", "evidence-boundary"]}},
    {"id": "S03", "index": 3, "slide_role": "data", "title_role": "judgment", "title": "收入三年接近翻倍；该趋势属于历史披露而非预测", "judgment": "2023–2025 年收入从 5.31 亿美元增至 10.38 亿美元。", "message": "单位：百万美元；截至每年 12 月 31 日。", "audience_question": "公开财务披露显示了怎样的规模变化？", "source_refs": [{"source_id": "B02-sec-company-facts", "locator": "Revenues, FY2023–FY2025", "claim_type": "direct"}], "primary_expression": "data_visual", "supporting_expressions": ["caption", "source_note"], "primary_anchor": "revenue-chart", "objects": [{"id": "revenue-chart", "type": "chart", "component_type": "bar_chart", "semantic_role": "historical_revenue", "content": {"categories": ["2023", "2024", "2025"], "series": [{"name": "收入（百万美元）", "values": [531.109, 748.024, 1037.589]}]}, "source_refs": [{"source_id": "B02-sec-company-facts", "locator": "us-gaap:Revenues, FY2023–FY2025", "claim_type": "direct"}], "complexity": {"series_count": 1, "category_count": 3}, "editability": "native_required", "priority": "primary"}], "delivery_contract": {"preferred_route": "native_chart", "editable_core": ["title", "revenue-chart"], "raster_allowance": [], "forbidden_raster": ["title", "revenue-chart"]}},
    {"id": "S04", "index": 4, "slide_role": "data", "title_role": "judgment", "title": "净利润在 2025 年扩大；驱动与可重复性仍待拆解", "judgment": "已披露净利润由 2023 年的 1,607 万美元增至 2025 年的 4.141 亿美元。", "message": "金额为历史年度净利润；不将其解释为未来盈利能力。", "audience_question": "利润历史支持什么，尚不足以支持什么？", "source_refs": [{"source_id": "B02-sec-company-facts", "locator": "NetIncomeLoss, FY2023–FY2025", "claim_type": "direct"}], "primary_expression": "data_visual", "supporting_expressions": ["interpretation", "source_note"], "primary_anchor": "net-income-chart", "objects": [{"id": "net-income-chart", "type": "chart", "component_type": "bar_chart", "semantic_role": "historical_profit", "content": {"categories": ["2023", "2024", "2025"], "series": [{"name": "净利润（百万美元）", "values": [16.067, 88.574, 414.065]}]}, "source_refs": [{"source_id": "B02-sec-company-facts", "locator": "us-gaap:NetIncomeLoss, FY2023–FY2025", "claim_type": "direct"}], "complexity": {"series_count": 1, "category_count": 3}, "editability": "native_required", "priority": "primary"}], "delivery_contract": {"preferred_route": "native_chart", "editable_core": ["title", "net-income-chart"], "raster_allowance": [], "forbidden_raster": ["title", "net-income-chart"]}},
