{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meowclawlab.dev/pptsmith/page-design-intent.schema.json",
  "title": "Page Design Intent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "slide_id",
    "slide_role",
    "audience_question",
    "message",
    "evidence_refs",
    "priority",
    "primary_expression",
    "page_archetype",
    "semantic_component",
    "visual_anchor",
    "layout",
    "density",
    "editability",
    "delivery",
    "style_system",
    "forbidden_patterns",
    "qa_focus"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "slide_id": {
      "type": "string",
      "minLength": 1
    },
    "slide_role": {
      "type": "string",
      "minLength": 1
    },
    "audience_question": {
      "type": "string",
      "minLength": 1
    },
    "message": {
      "type": "string",
      "minLength": 1
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "object",
            "additionalProperties": true
          }
        ]
      }
    },
    "priority": {
      "type": "string",
      "minLength": 1
    },
    "primary_expression": {
      "type": "string",
      "minLength": 1
    },
    "page_archetype": {
      "type": "string",
      "minLength": 1
    },
    "semantic_component": {
      "type": "string",
      "minLength": 1
    },
    "visual_anchor": {
      "type": "string",
      "minLength": 1
    },
    "layout": {
      "type": "object",
      "additionalProperties": true
    },
    "density": {
      "type": "object",
      "additionalProperties": true
    },
    "editability": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "message_bearing"
      ],
      "properties": {
        "message_bearing": {
          "type": "string",
          "enum": [
            "native_required",
            "native_preferred",
            "hybrid_allowed",
            "raster_allowed"
          ]
        }
      }
    },
    "delivery": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "allowed_fallbacks"
      ],
      "properties": {
        "allowed_fallbacks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "style_system": {
      "type": "object",
      "additionalProperties": true
    },
    "forbidden_patterns": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "qa_focus": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  }
}
