{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meowclawlab.dev/pptsmith/source-context-brief.schema.json",
  "title": "PPTSmith Source Context Brief",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_id",
    "primary_audience",
    "delivery_objective",
    "source_material_type",
    "evidence_profile",
    "industry_compliance_context",
    "delivery_scenario"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "source_id": {"type": "string", "minLength": 1},
    "primary_audience": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "delivery_objective": {"type": "string", "minLength": 1},
    "source_material_type": {"type": "string", "minLength": 1},
    "evidence_profile": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "industry_compliance_context": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "delivery_scenario": {"type": "string", "minLength": 1}
  }
}
